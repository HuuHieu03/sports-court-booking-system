POSTGRES_USER=football
POSTGRES_PASSWORD=change-me
POSTGRES_DB=football_booking
POSTGRES_PORT=5432

# Phải khớp với các giá trị POSTGRES_* ở trên. Giữ nguyên dấu nháy và phần options:
# @prisma/adapter-pg gửi thời gian không kèm múi giờ, options ép phiên kết nối dùng UTC để không lưu lệch giờ.
DATABASE_URL="postgresql://football:change-me@localhost:5432/football_booking?schema=public&options=-c%20TimeZone%3DUTC"

# Mật khẩu chung của mọi tài khoản mẫu do prisma/seed.ts tạo, tối thiểu 8 ký tự.
SEED_PASSWORD=change-me-too
