# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build Output
dist/
build/
out/
*.tsbuildinfo

# Environment and Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Private Personal Workspace (strictly local, never committed)
/my_workspace/

# Testing and Coverage
coverage/
.nyc_output/

# Logs
logs/
*.log

# Benchmark transient data / raw outputs
benchmarks/results/
benchmarks/raw/

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# IDE and Editor settings (keep user specific out of git)
.idea/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# Python & uv virtual environment
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
